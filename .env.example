# Canonical demo origin. Set the production replacement domain separately if approved.
NEXT_PUBLIC_SITE_URL=https://cbkforever.com

# Clerk: use values from the College Boy Clerk application only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# Supabase: use a dedicated College Boy project. Never expose the service role key.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fee The Developer client dashboard (/dashboard). Fee The Developer's portal
# Supabase project only — never a client project. Anon key only; RLS plus the
# signed-in user's Clerk token decide access. No service-role key is used.
FTD_PORTAL_SUPABASE_URL=
FTD_PORTAL_SUPABASE_ANON_KEY=
